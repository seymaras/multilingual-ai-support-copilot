# Copy to .env and adjust. All variables are optional; defaults shown.

# --- Models ---
# Multilingual bi-encoder used for first-stage retrieval
COPILOT_EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Multilingual cross-encoder used for reranking
COPILOT_RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Ollama model tag used for answer generation
COPILOT_LLM_MODEL_NAME=qwen3:4b

# --- Ollama ---
COPILOT_OLLAMA_HOST=http://localhost:11434
# Per-request timeout. Worst-case latency is (1 + LLM_MAX_RETRIES) x this value.
COPILOT_OLLAMA_TIMEOUT_SECONDS=60
# Extra attempts when the LLM returns JSON that does not match the schema
COPILOT_LLM_MAX_RETRIES=2
# Reasoning ("thinking") mode for models like qwen3; keep off for support answers
COPILOT_LLM_THINK=false

# --- Documents ---
# Directory of *.txt documents; each file stem is its document ID
COPILOT_DOCUMENTS_DIR=data

# --- Chunking (server-side only) ---
COPILOT_CHUNK_SIZE=50
COPILOT_MAX_CHUNK_SIZE=512
COPILOT_CHUNK_OVERLAP=0

# --- Retrieval bounds ---
COPILOT_DEFAULT_TOP_K=3
COPILOT_MAX_TOP_K=20
COPILOT_DEFAULT_CANDIDATE_K=5
COPILOT_MAX_CANDIDATE_K=50
COPILOT_MAX_QUERY_CHARS=2000
